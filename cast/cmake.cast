```codesign
COMMAND codesign --force --options runtime --entitlements "${CMAKE_SOURCE_DIR}/:::entitlementsPath:::" --sign ":::identity:::" "$<TARGET_BUNDLE_DIR:${PROJECT_NAME}>"
```

```xattr
COMMAND xattr -cr "$<TARGET_BUNDLE_DIR:${PROJECT_NAME}>"
```

```verify
COMMAND codesign --verify --verbose "$<TARGET_BUNDLE_DIR:${PROJECT_NAME}>"
```

```pkg-staging
COMMAND ${CMAKE_COMMAND} -E rm -rf "${CMAKE_BINARY_DIR}/installer"
COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_BINARY_DIR}/installer/root"
COMMAND ditto "$<TARGET_BUNDLE_DIR:${PROJECT_NAME}>" "${CMAKE_BINARY_DIR}/installer/root/$<TARGET_BUNDLE_DIR_NAME:${PROJECT_NAME}>"
COMMAND pkgbuild --analyze --root "${CMAKE_BINARY_DIR}/installer/root" "${CMAKE_BINARY_DIR}/installer/component.plist"
COMMAND plutil -replace 0.BundleIsRelocatable -bool NO "${CMAKE_BINARY_DIR}/installer/component.plist"
```

```pkgbuild
COMMAND pkgbuild --root "${CMAKE_BINARY_DIR}/installer/root" --install-location ":::installDirectory:::" --component-plist "${CMAKE_BINARY_DIR}/installer/component.plist" --identifier :::bundleIdentifier::: --version "${PROJECT_VERSION}" "${CMAKE_BINARY_DIR}/${PROJECT_NAME}.pkg"
```

```productbuild
COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_BINARY_DIR}/installer/resources" "${CMAKE_SOURCE_DIR}/${CAST_PACK_folder}"
COMMAND ${CMAKE_COMMAND} -E copy ":::installerResourceDirectory:::/background.png" ":::installerResourceDirectory:::/background-dark.png" "${CMAKE_SOURCE_DIR}/LICENSE" "${CMAKE_BINARY_DIR}/installer/resources/"
COMMAND productbuild --distribution "${CMAKE_BINARY_DIR}/distribution.xml" --package-path "${CMAKE_BINARY_DIR}" --resources "${CMAKE_BINARY_DIR}/installer/resources" "${CMAKE_BINARY_DIR}/unsigned.pkg"
```

```productsign
COMMAND productsign --sign ":::installerIdentity:::" "${CMAKE_BINARY_DIR}/unsigned.pkg" "${CAST_PACK_ARCHIVE}"
```

```notarize
COMMAND xcrun notarytool submit "${CAST_PACK_ARCHIVE}" --keychain-profile ":::notaryProfile:::" --wait
```

```staple
COMMAND xcrun stapler staple "${CAST_PACK_ARCHIVE}"
```

```makensis
COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_SOURCE_DIR}/${CAST_PACK_folder}"
COMMAND makensis "/DARTEFACT=$<SHELL_PATH:$<TARGET_FILE:${PROJECT_NAME}>>" "/DOUTFILE=$<SHELL_PATH:${CAST_PACK_ARCHIVE}>" "/DRESOURCES=${CAST_INSTALLER_RESOURCES}" "/DLICENSE=$<SHELL_PATH:${CMAKE_SOURCE_DIR}/LICENSE>" "/DICON=$<SHELL_PATH:$<TARGET_PROPERTY:${PROJECT_NAME},JUCE_ICON_FILE>>" "/DSIGNTOOL=$<SHELL_PATH:${CAST_INSTALLER_SIGNTOOL}>" "$<SHELL_PATH:${CMAKE_SOURCE_DIR}/cast/installer/win/installer.nsi>"
```

```gh
set(CAST_RELEASE_VERSION :::versionString:::)
set(CAST_RELEASE_TAG "v${CAST_RELEASE_VERSION}")

:::[list]:::

file(GLOB CAST_RELEASE_ASSETS "${CMAKE_CURRENT_LIST_DIR}/${CAST_PACK_folder}/:::productName::: v${CAST_RELEASE_VERSION} *")

if(NOT CAST_RELEASE_ASSETS)
    message(FATAL_ERROR "CAST: no release asset for ${CAST_RELEASE_TAG} in ${CAST_PACK_folder}")
endif()

execute_process(COMMAND gh release view "${CAST_RELEASE_TAG}" --repo ":::repository:::" RESULT_VARIABLE CAST_RELEASE_VIEW OUTPUT_QUIET ERROR_QUIET)

if(CAST_RELEASE_VIEW EQUAL 0)
    execute_process(COMMAND gh release upload "${CAST_RELEASE_TAG}" ${CAST_RELEASE_ASSETS} --repo ":::repository:::" --clobber COMMAND_ERROR_IS_FATAL ANY)
else()
    execute_process(COMMAND gh release create "${CAST_RELEASE_TAG}" ${CAST_RELEASE_ASSETS} --repo ":::repository:::" --title "${CAST_RELEASE_TAG}" --notes-file "${CMAKE_CURRENT_LIST_DIR}/RELEASE.md" COMMAND_ERROR_IS_FATAL ANY)
endif()
```
