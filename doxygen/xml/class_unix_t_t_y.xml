        <type>bool</type>
        <definition>bool UnixTTY::open</definition>
        <argsstring>(jam::Cell::Rectangle dims, const juce::String &amp;shell, const juce::String &amp;args={}, const juce::String &amp;workingDirectory={}) override</argsstring>
        <name>open</name>
        <qualifiedname>UnixTTY::open</qualifiedname>
        <reimplements refid="class_t_t_y_1aada0eab29680dd29ab03b4db0f7eb169">open</reimplements>
        <param>
          <type><ref refid="structjam_1_1_cell_1_1_rectangle" kindref="compound" external="/Users/jreng/Documents/Poems/dev/jam/doxygen/tagfile.xml">jam::Cell::Rectangle</ref></type>
