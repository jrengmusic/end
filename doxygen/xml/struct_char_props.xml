<codeline><highlight class="normal"><ref refid="_char_props_8h_1a7bdc2c8b0aa8edbd7dad4d7d4fe2c1c9" kindref="member">charPropsFor</ref>(0x0041).<ref refid="struct_char_props_1aab64b65c32193f3e05ce27a88e7692ff" kindref="member">isEmojiPresentation</ref>()<sp/><sp/></highlight><highlight class="comment">//<sp/>false<sp/>(letter<sp/>A)</highlight></codeline>
</programlisting> </para>
</simplesect>
</para>
