<codeline lineno="50"><highlight class="normal">{</highlight></codeline>
<codeline lineno="51"><highlight class="normal"><sp/><sp/><sp/><sp/>0x25C6,<sp/>0x2592,<sp/>0x2409,<sp/>0x240C,<sp/>0x240D,<sp/>0x240A,<sp/>0x00B0,<sp/>0x00B1,</highlight></codeline>
<codeline lineno="52"><highlight class="normal"><sp/><sp/><sp/><sp/>0x2424,<sp/>0x240B,<sp/>0x2518,<sp/>0x2510,<sp/>0x250C,<sp/>0x2514,<sp/>0x253C,<sp/>0x23BA,</highlight></codeline>
<codeline lineno="53"><highlight class="normal"><sp/><sp/><sp/><sp/>0x23BB,<sp/>0x2500,<sp/>0x23BC,<sp/>0x23BD,<sp/>0x251C,<sp/>0x2524,<sp/>0x2534,<sp/>0x252C,</highlight></codeline>
