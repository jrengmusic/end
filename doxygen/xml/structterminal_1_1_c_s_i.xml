      <memberdef kind="variable" id="structterminal_1_1_c_s_i_1ab4ca2a0bec07ba138196a3e62dd27c10" prot="public" static="no" mutable="no">
        <type>uint16_t</type>
        <definition>uint16_t terminal::CSI::accumulator</definition>
        <argsstring></argsstring>
        <name>accumulator</name>
        <qualifiedname>terminal::CSI::accumulator</qualifiedname>
        <initializer>{ 0 }</initializer>
        <briefdescription>
<para>Temporary accumulator for building the current parameter value. </para>
        </briefdescription>
        <detaileddescription>
<para>As digits are fed via <computeroutput><ref refid="structterminal_1_1_c_s_i_1a8a3f0c7648031f973e5bb63fd1f81a06" kindref="member">addDigit()</ref></computeroutput>, this value grows: &apos;1&apos; -&gt; 1, &apos;12&apos; -&gt; 12, etc. When a separator or final byte is encountered, this value is copied to <computeroutput><ref refid="structterminal_1_1_c_s_i_1a4590c3aca4c7b4a33547974bc59c9906" kindref="member">values</ref></computeroutput> and the accumulator is reset.</para>
<para><simplesect kind="see"><para><ref refid="structterminal_1_1_c_s_i_1a91d13ea91357c8ab601596bc9da18063" kindref="member">hasAccumulator</ref> indicates whether any digits have been accumulated </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="terminal/CSI.h" line="137" column="14" bodyfile="terminal/CSI.h" bodystart="137" bodyend="137"/>
        <referencedby refid="structterminal_1_1_c_s_i_1a8a3f0c7648031f973e5bb63fd1f81a06" compoundref="_c_s_i_8h" startline="174" endline="178">addDigit</referencedby>
        <referencedby refid="structterminal_1_1_c_s_i_1a2531da13a92b9ed183e74788fafd555d" compoundref="_c_s_i_8h" startline="221" endline="239">addSeparator</referencedby>
