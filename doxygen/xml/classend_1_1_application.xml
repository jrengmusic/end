      <memberdef kind="function" id="classend_1_1_application_1a18d7fd1d8bbcca6a1c7af73e3bf503a8" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void end::Application::shutdown</definition>
        <argsstring>() override</argsstring>
        <name>shutdown</name>
        <qualifiedname>end::Application::shutdown</qualifiedname>
        <briefdescription>
<para>Destroys the main window and releases all resources. </para>
        </briefdescription>
        <detaileddescription>
<para>Destruction order:<orderedlist>
<listitem><para>link — disconnect IPC before sessions die.</para>
</listitem><listitem><para>daemon — stop server.</para>
</listitem><listitem><para>mainWindow — tears down component tree (Display → Processor refs).</para>
</listitem><listitem><para>nexus — releases all terminal::Session objects.</para>
</listitem></orderedlist>
</para>
<para><simplesect kind="note"><para>MESSAGE THREAD — called once at shutdown. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="Main.h" line="54" column="10" bodyfile="Main.cpp" bodystart="41" bodyend="41"/>
