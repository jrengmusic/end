        <definition>void end::Application::initialise</definition>
        <argsstring>(const juce::String &amp;commandLine) override</argsstring>
        <name>initialise</name>
        <qualifiedname>end::Application::initialise</qualifiedname>
        <param>
          <type>const juce::String &amp;</type>
          <declname>commandLine</declname>
        </param>
        <briefdescription>
<para>Creates the main window and wires up all subsystems. </para>
        </briefdescription>
        <detaileddescription>
<para>Called by JUCE after the message loop starts. Reads window geometry and appearance from Config, then constructs a <computeroutput><ref refid="classjam_1_1_window" kindref="compound" external="/Users/jreng/Documents/Poems/dev/jam/doxygen/tagfile.xml">jam::Window</ref></computeroutput> wrapping a freshly allocated <computeroutput>MainComponent</computeroutput>.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>commandLine</parametername>
</parameternamelist>
<parameterdescription>
<para>The raw command-line string passed to the process. Currently unused; reserved for future shell override.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="note"><para>MESSAGE THREAD — called once at startup.</para>
</simplesect>
<simplesect kind="see"><para>lua::Engine::Display::Window </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="Main.h" line="41" column="10" bodyfile="Main.cpp" bodystart="8" bodyend="40"/>
